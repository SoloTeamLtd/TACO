<?xml version="1.0" encoding="UTF-8"?>
<configuration>

<!-- Цветовая схема для консоли -->
<property name="CONSOLE_LOG_PATTERN"
          value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %5level %logger{36} - %msg%n"/>

<!-- Путь к файлам логов -->
<property name="LOG_FILE_PATH" value="logs/tacoapp"/>

<!-- 1. Консольный аппендер -->
<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
        <pattern>${CONSOLE_LOG_PATTERN}</pattern>
    </encoder>
</appender>

<!-- 2. Файловый аппендер с ротацией (каждый день или при достижении 10МБ) -->
<appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_FILE_PATH}.log</file>
    <encoder>
        <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
    </encoder>
    <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
        <!-- Логи архивируются каждый день -->
        <fileNamePattern>${LOG_FILE_PATH}-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
        <timeBasedFileTableRemover class="ch.qos.logback.core.rolling.helper.TimeBasedArchiveRemover"/>
        <timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
            <maxFileSize>10MB</maxFileSize>
        </timeBasedFileNamingAndTriggeringPolicy>
        <!-- Хранить архивы логов за последние 1 дней -->
        <maxHistory>1</maxHistory>
    </rollingPolicy>
</appender>

<!-- Логируем наш SMS-заглушку и смену статусов на уровне INFO -->
<logger name="com.example.springinaction.tacoapp.notification" level="INFO"/>
<logger name="com.example.springinaction.tacoapp.order.service" level="INFO"/>

<!-- Настройки для локальной разработки (профиль dev) -->
<springProfile name="dev">
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
    <!-- Подсвечиваем SQL-запросы от Hibernate для отладки двух БД -->
    <logger name="org.hibernate.SQL" level="DEBUG"/>
</springProfile>

<!-- Настройки для сервера (профиль prod) -->
<springProfile name="prod">
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</springProfile>
</configuration>
